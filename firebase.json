{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "ticketid-ab43c",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "/media/**", "function": "api" },
      { "source": "/", "destination": "/fan/index.html" },
      { "source": "/verify", "destination": "/fan/index.html" },
      { "source": "/reset", "destination": "/fan/index.html" },
      { "source": "/receiver/**", "destination": "/receiver/index.html" },
      { "source": "/dashboard/**", "destination": "/dashboard/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
